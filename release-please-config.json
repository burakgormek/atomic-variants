{
  "include-component-in-tag": true,
  "tag-separator": "@",
  "packages": {
    "packages/core": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "extra-label": "core",
      "extra-files": [
        {
          "type": "json",
          "path": "/bun.lock",
          "jsonpath": "$.workspaces['packages/core'].version"
        }
      ]
    },
    "packages/swc-plugin": {
      "release-type": "node",
      "bump-minor-pre-major": true,
      "extra-label": "swc-plugin",
      "extra-files": [
        {
          "type": "json",
          "path": "/bun.lock",
          "jsonpath": "$.workspaces['packages/swc-plugin'].version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "updatePeerDependencies": true,
      "updateAllPackages": true,
      "merge": true
    },
    {
      "type": "linked-versions",
      "groupName": "core-and-plugins",
      "components": [
        "core",
        "webpack-plugin",
        "next-plugin",
        "vite-plugin",
        "swc-plugin"
      ]
    }
  ],
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
